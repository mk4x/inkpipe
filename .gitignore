node_modules/
dist/
build/
.next/
target/

.env
.env.*
!.env.example

*.log
.DS_Store
Thumbs.db

# Expo
.expo/
*.jks
*.keystore

# Tauri
apps/desktop/src-tauri/target/

# Local model fixtures are committed, recordings are not
packages/corpus/recordings/

# Never commit a real config or any key material
inkpipe.config.json
*.pem
*.key

# built UI (rebuilt by npm run ui:build)
apps/desktop/ui/dist/

# Expo generates these from app.json via prebuild; they are not source.
apps/phone/android/
apps/phone/ios/
apps/phone/.expo/

# Built APKs, produced by apps/phone build
dist/

# Local runtime config and credentials. These belong in the OS config
# directory, never in the repo, and never in a commit.
config.json
secrets.json
keys.json
research.json

# Anything a key might get pasted into. The leak this prevents already
# happened once: an API key sat in "New Text Document.txt" and a "git add -A"
# swept it into a public commit.
*.txt
!requirements*.txt

# Installer output and staging.
build/
